# LLM provider: stub (default, offline), anthropic, or vertex.
# Never commit API keys. Copy this file to .env for local overrides.
WATCHFLOOR_LLM_PROVIDER=stub
WATCHFLOOR_ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=

# Vertex / Gemini on Google Cloud (optional). Used only when WATCHFLOOR_LLM_PROVIDER=vertex.
WATCHFLOOR_VERTEX_MODEL=gemini-2.5-flash
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# Leave WATCHFLOOR_DATABASE_URL empty to use the in-memory store (default for tests and the no-docker demo).
# With docker compose, the API service is given a Postgres URL automatically.
# WATCHFLOOR_DATABASE_URL=postgresql://watchfloor:watchfloor@127.0.0.1:5432/watchfloor

# Durable approval state and the hash-chained audit log. Defaults under ./data.
# WATCHFLOOR_DATA_DIR=./data

# Workflow backend: inprocess (default, sqlite-backed, crash-safe) or temporal.
WATCHFLOOR_WORKFLOW_BACKEND=inprocess
# TEMPORAL_ADDRESS=127.0.0.1:7233
# TEMPORAL_NAMESPACE=default

# API bind (docker compose sets these).
# WATCHFLOOR_API_HOST=0.0.0.0
# WATCHFLOOR_API_PORT=8080
